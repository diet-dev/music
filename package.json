{
  "name": "@dietdev/music",
  "version": "0.1.0",
  "description": "Музыкальный плеер на Web Audio: кроссфейд, даккинг, темп, отложенная загрузка треков",
  "keywords": [
    "webaudio",
    "audio",
    "music",
    "crossfade",
    "ducking",
    "game",
    "typescript"
  ],
  "author": "dietdev <dietdev.tech@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diet-dev/music.git"
  },
  "homepage": "https://github.com/diet-dev/music#readme",
  "bugs": {
    "url": "https://github.com/diet-dev/music/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.ts\"",
    "test:watch": "node --disable-warning=ExperimentalWarning --test --watch \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
